{
  "name": "strideterm",
  "version": "1.7.1",
  "description": "Multi-workspace terminal app for developers with Docker, Git, remote access, and plugin support",
  "author": "strIDEterm Contributors <strideterm@stradej.cz>",
  "license": "MIT",
  "engines": {
    "node": ">=22",
    "npm": ">=10"
  },
  "keywords": [
    "terminal",
    "electron",
    "workspace",
    "docker",
    "git",
    "xterm",
    "developer-tools"
  ],
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:web\" \"npm:dev:electron\"",
    "dev:web": "vite --config vite.config.js",
    "dev:electron": "node scripts/dev-electron.mjs",
    "start": "npm run build && node scripts/start-electron.mjs --dist",
    "build": "vite build --config vite.config.js",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:linux": "npm run build && electron-builder --linux",
    "smoke": "npm run build && node scripts/smoke.mjs",
    "perf": "node --expose-gc scripts/perf-test.mjs",
    "test": "npm run test:ui && npm run test:backend",
    "test:ui": "vitest run --config vite.config.js",
    "test:backend": "vitest run --config vitest.backend.config.js",
    "test:e2e": "npx playwright test",
    "lint": "eslint . && prettier --check .",
    "lint:fix": "eslint --fix . && prettier --write .",
    "audit:security": "npm audit --audit-level=high",
    "audit:package-age": "node scripts/check-package-age.mjs",
    "prepare": "husky"
  },
  "build": {
    "appId": "com.strideterm.app",
    "productName": "strIDEterm",
    "directories": {
      "output": "release"
    },
    "asar": true,
    "asarUnpack": [
      "**/node_modules/node-pty/**"
    ],
    "files": [
      "dist/**/*",
      "electron/**/*",
      "config/**/*",
      "assets/**/*",
      "plugins/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "plugins",
        "to": "plugins",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "artifactName": "${productName}-${version}-${os}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "assets/icon.ico",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools",
      "icon": "assets/icon.icns"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Development",
      "icon": "assets/icon.png"
    }
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "monaco-editor": "^0.55.1",
    "node-pty": "^1.1.0",
    "pinia": "^3.0.4",
    "qrcode": "^1.5.4",
    "splitpanes": "^4.0.4",
    "vue": "^3.5.32",
    "winston": "^3.19.0",
    "ws": "^8.20.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.59.1",
    "@vitejs/plugin-vue": "^6",
    "@vue/test-utils": "^2.4",
    "concurrently": "^9.2.1",
    "electron": "^41.2.1",
    "electron-builder": "^26.8.1",
    "eslint": "^10.2.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.8.0",
    "globals": "^17.5.0",
    "husky": "^9.1.7",
    "jsdom": "^29.0.2",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.3",
    "vite": "^8.0.8",
    "vitest": "^4.1.4",
    "wait-on": "^9.0.5"
  },
  "overrides": {
    "dompurify": "3.4.0"
  },
  "lint-staged": {
    "*.{js,vue}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css}": [
      "prettier --write"
    ]
  }
}
