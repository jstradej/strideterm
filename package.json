{
  "name": "strideterm",
  "version": "2.4.19",
  "description": "Multi-workspace terminal app for developers with Docker, Git, remote access, and plugin support",
  "author": "strIDEterm Contributors <strideterm@stradej.cz>",
  "license": "MIT",
  "engines": {
    "node": ">=22",
    "npm": ">=10"
  },
  "keywords": [
    "terminal",
    "electron",
    "workspace",
    "docker",
    "git",
    "xterm",
    "developer-tools"
  ],
  "type": "module",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:web\" \"npm:dev:backend\" \"npm:dev:preload\" \"npm:dev:electron\"",
    "dev:web": "vite --config vite.config.ts",
    "dev:backend": "tsc -p tsconfig.backend.json --watch --preserveWatchOutput",
    "dev:preload": "tsc -p tsconfig.preload.json --watch --preserveWatchOutput",
    "dev:electron": "tsx scripts/dev-electron.mts",
    "start": "npm run build && tsx scripts/start-electron.mts --dist",
    "build": "vue-tsc --noEmit -p tsconfig.frontend.json && vite build && tsc -p tsconfig.backend.json && tsc -p tsconfig.preload.json && tsx scripts/copy-shell-integration.mts",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:linux": "npm run build && electron-builder --linux",
    "smoke": "npm run build && tsx scripts/smoke.mts",
    "measure:remote": "tsx scripts/measure-remote-payload.mts",
    "smoke:remote-tunnel": "tsx scripts/remote-tunnel-smoke.mts",
    "test": "npm run test:ui && npm run test:backend",
    "test:ui": "vitest run --config vite.config.ts",
    "test:backend": "vitest run --config vitest.backend.config.ts",
    "test:e2e": "npx playwright test",
    "test:e2e:electron": "npm run build && npx playwright test --config playwright.config.electron.js",
    "test:e2e:electron:visual": "npx playwright test --config playwright.config.electron.js --grep @visual",
    "test:e2e:electron:update": "npx playwright test --config playwright.config.electron.js --grep @visual --update-snapshots",
    "lint": "eslint . && prettier --check .",
    "lint:fix": "eslint --fix . && prettier --write .",
    "typecheck": "vue-tsc --noEmit -p tsconfig.frontend.json && tsc --noEmit -p tsconfig.backend.json && tsc --noEmit -p tsconfig.preload.json && tsc --noEmit -p tsconfig.tests.json && tsc --noEmit -p tsconfig.scripts.json",
    "audit:security": "npm audit --audit-level=high",
    "audit:package-age": "tsx scripts/check-package-age.mts",
    "prepare": "husky"
  },
  "build": {
    "appId": "com.strideterm.app",
    "productName": "strIDEterm",
    "directories": {
      "output": "release"
    },
    "asar": true,
    "asarUnpack": [
      "**/node_modules/node-pty/**",
      "**/node_modules/ssh2/**",
      "**/node_modules/cpu-features/**"
    ],
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "config/shell-integration/**/*",
      "assets/**/*",
      "plugins/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "plugins",
        "to": "plugins",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "config/shell-integration",
        "to": "config/shell-integration",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "artifactName": "${productName}-${version}-${os}-${arch}.${ext}"
    },
    "portable": {
      "unpackDirName": true
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "assets/icon.ico",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-mac-${arch}.${ext}",
      "category": "public.app-category.developer-tools",
      "icon": "assets/icon.icns",
      "identity": null
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Development",
      "icon": "assets/icon.png"
    }
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "0.16.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/xterm": "^6.0.0",
    "effect": "4.0.0-beta.90",
    "monaco-editor": "^0.56.0",
    "node-pty": "^1.1.0",
    "pinia": "^4.0.2",
    "proper-lockfile": "4.1.2",
    "qrcode": "^1.5.4",
    "splitpanes": "^4.1.2",
    "ssh-config": "^5.2.0",
    "ssh2": "^1.17.0",
    "sshpk": "^1.18.0",
    "vue": "^3.5.40",
    "winston": "^3.19.0",
    "ws": "^8.21.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@effect/language-service": "0.87.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@types/node": "26.1.1",
    "@types/proper-lockfile": "4.1.4",
    "@types/qrcode": "1.5.6",
    "@types/ssh2": "1.15.5",
    "@types/sshpk": "1.17.5",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-vue": "^6",
    "@vue/eslint-config-typescript": "14.9.0",
    "@vue/test-utils": "^2.4",
    "concurrently": "^10.0.3",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-security": "4.0.1",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.2.0",
    "prettier": "^3.9.6",
    "tsx": "4.23.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10",
    "vue-tsc": "3.3.8",
    "wait-on": "^9.1.0"
  },
  "overrides": {
    "dompurify": "3.4.12",
    "uuid": "^14.0.0",
    "fast-uri": "^3.1.4",
    "hono": "4.12.31",
    "tmp": "^0.2.6",
    "qs": "^6.15.2",
    "postcss": "8.5.25",
    "nanoid": "3.3.15",
    "shell-quote": "^1.10.0",
    "brace-expansion@1": "1.1.18",
    "brace-expansion@2": "2.1.4",
    "brace-expansion@5": "5.0.9"
  },
  "lint-staged": {
    "*.{js,ts,vue,mts}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css}": [
      "prettier --write"
    ]
  }
}
